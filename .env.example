APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Google OAuth web client; register this exact callback URL in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# WebAuthn passkeys work on localhost or an HTTPS origin. For a stable
# Tailscale hostname, set the matching host and full HTTPS origin explicitly.
PASSKEYS_RP_ID=
PASSKEYS_ORIGIN=
PASSKEYS_USER_HANDLE_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Smart Basket"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Uses OpenAI's Images API edit endpoint with both input images. Add a valid
# server-side API key before enabling previews in a deployed environment.
VIRTUAL_TRYON_PROVIDER=openai
VIRTUAL_TRYON_API_KEY=
VIRTUAL_TRYON_BASE_URL=https://api.openai.com/v1/images/edits
VIRTUAL_TRYON_MODEL=gpt-image-1
VIRTUAL_TRYON_SIZE=1024x1024
VIRTUAL_TRYON_QUALITY=high
VIRTUAL_TRYON_TIMEOUT=120

# Customer Smart AI: OpenAI-compatible server-side provider configuration.
# Set AI_API_KEY (or the legacy GROQ_API_KEY) in your real .env, never in frontend code.
AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT=25

# Optional OpenAI-compatible fallback. It is attempted only if the primary
# provider is unavailable; leave blank to disable provider failover.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=

# Smart AI live web search provider: google (Gemini Google Search grounding) or tavily.
# Google uses Google's official Gemini Interactions API and may incur search grounding charges.
# Obtain a Gemini API key from Google AI Studio; never expose it to frontend code.
AI_WEB_SEARCH_PROVIDER=google
AI_WEB_SEARCH_FALLBACK_PROVIDER=tavily
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Optional Tavily fallback. Select AI_WEB_SEARCH_PROVIDER=tavily to use it.
TAVILY_API_KEY=
AI_WEB_SEARCH_KEYLESS=true
AI_WEB_TIMEOUT=15
AI_WEB_RESULTS=5
AI_WEB_CACHE_TTL=300

# Razorpay test credentials only. Set RAZORPAY_MODE=live only after production review.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Backward-compatible aliases for existing deployments:
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional seller SMS alerts for order cancellations. Configure Twilio to enable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Set a supported Meta Graph API version before enabling seller WhatsApp PDF invoices.
WHATSAPP_GRAPH_API_VERSION=v26.0

# Order return request window (days after purchase)
ORDER_RETURN_WINDOW_DAYS=30
